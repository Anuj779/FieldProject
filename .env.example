# Copy to .env. Never commit real secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Firebase console > Project settings > Your apps > Web app configuration.
FIREBASE_WEB_CONFIG={"apiKey":"","authDomain":"","projectId":"","appId":""}
# Absolute path to your Firebase Admin service account JSON, kept outside this repo.
GOOGLE_APPLICATION_CREDENTIALS=
PORT=5000

# Vercel only: service-account JSON as a private environment variable.
FIREBASE_ADMIN_CREDENTIALS=
